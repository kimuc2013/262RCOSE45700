# backfill/.env.example → backfill/.env로 복사해서 값을 채움 (.env는 커밋 금지)
# 실제 엔드포인트 주소는 공개 저장소에 올리지 않음 → 팀 채널의 Furiosa RAG API 가이드 참고

# 임베딩 API (Furiosa RNGD, 키 없음, 사용 기간 2026-10-27 ~ 12-09)
BGE_BASE_URL=http://<embedding-host>:<port>/v1
BGE_MODEL=furiosa-ai/bge-m3
BGE_REVISION=v2026.4
# 세 조가 함께 쓰는 서버라 배치로 요청. 문장당 최대 8,192토큰
EMBED_BATCH_SIZE=32

# VLM (sources.yaml의 vlm_images만 읽음). 모델 이름은 furiosa-ai/ 접두어 포함
QWEN_BASE_URL=https://<qwen-host>/v1
QWEN_VLM_MODEL=furiosa-ai/Qwen3-VL-32B-Instruct
FURIOSA_API_KEY=

# 데이터 경로 (backfill/ 기준)
DATA_DIR=data

# 크롤링
USER_AGENT=KU-AcademicInfo-MCP-Backfill/0.1 (student project)
REQUEST_INTERVAL_SEC=1.0
