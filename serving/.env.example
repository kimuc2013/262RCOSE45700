# These variables must be exported by your shell or supplied with compose --env-file.
ACADEMIC_DB=data/academic.sqlite3
MODEL_MODE=local
# remote mode requires the real model service. /v1/rerank is a proposed contract.
MODEL_BASE_URL=http://127.0.0.1:9000
MODEL_API_KEY=
EMBEDDING_MODEL=
REWRITE_MODEL=
RERANK_MODEL=
RERANK_PATH=/v1/rerank
MODEL_TIMEOUT_SECONDS=15
# Leave unset until calibrated on the reviewed evaluation set.
RERANK_MIN_SCORE=

# Online admission settings. Initial operational defaults, not measured targets.
SERVING_MAX_RUNNING=4
SERVING_MAX_QUEUED=8
SERVING_MAX_WAITERS=64
SERVING_REQUEST_TIMEOUT=10
SERVING_QUEUE_TIMEOUT=1
# Change this when weights/config change while keeping the same model ID.
SERVING_MODEL_REVISION=unversioned
